# Loaded by docker-compose (env_file). Service URLs use docker-compose service names;
# when running this service with plain `npm run dev`, change them to http://localhost:<port>.
PORT=5001
SERVICE_NAME=Auth Service
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/auth_db?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
ADMIN_EMAIL=admin@fooddelivery.local
ADMIN_PASSWORD=ChangeMe123!
