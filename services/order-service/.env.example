# Loaded by docker-compose (env_file). Service URLs use docker-compose service names;
# when running this service with plain `npm run dev`, change them to http://localhost:<port>.
PORT=5003
SERVICE_NAME=Order Service
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/order_db?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
RESTAURANT_SERVICE_URL=http://restaurant-service:5002
CUSTOMER_SERVICE_URL=http://customer-service:5005
