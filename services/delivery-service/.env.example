# Loaded by docker-compose (env_file). Service URLs use docker-compose service names;
# when running this service with plain `npm run dev`, change them to http://localhost:<port>.
PORT=5004
SERVICE_NAME=Delivery Service
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/delivery_db?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
ORDER_SERVICE_URL=http://order-service:5003
RESTAURANT_SERVICE_URL=http://restaurant-service:5002
