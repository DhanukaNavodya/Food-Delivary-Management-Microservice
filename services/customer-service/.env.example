# Loaded by docker-compose (env_file). Service URLs use docker-compose service names;
# when running this service with plain `npm run dev`, change them to http://localhost:<port>.
PORT=5005
SERVICE_NAME=Customer Service
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/customer_db?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
