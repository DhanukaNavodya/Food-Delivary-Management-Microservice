# Loaded by docker-compose (env_file). Service URLs use docker-compose service names;
# when running this service with plain `npm run dev`, change them to http://localhost:<port>.
PORT=5002
SERVICE_NAME=Restaurant Service
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/restaurant_db?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
SEED_DATA=true
